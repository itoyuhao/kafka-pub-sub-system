flowchart LR
    subgraph Producer["Producer (Async - AIOProducer)"]
        GEN_TXN["generate_transaction()"]
        GEN_LOGIN["generate_login()"]
        FRAUD["simulate_fraud_burst()"]
    end

    subgraph Kafka["Kafka (KRaft)"]
        T_TXN[["epay_transactions\n(3 partitions)"]]
        T_LOGIN[["epay_logins\n(3 partitions)"]]
        T_DLQ[["epay_dlq\n(1 partition)"]]
        T_ALERTS[["epay_account_alerts\n(3 partitions)"]]
    end

    subgraph Consumer["Consumer (Sync)"]
        PARSE["JSON Parse\n+ Dataclass Validation"]
        LATE["Late Data Check"]
        VELOCITY["Velocity Check\n(Sliding Window)"]
        DLQ_SEND["DLQ Handler"]
        ALERT_SEND["Alert Publisher"]
    end

    subgraph ClickHouse["ClickHouse (OLAP)"]
        subgraph FactTables["Fact Tables (Append-only)"]
            FT["fact_transactions"]
            FL["fact_logins"]
            FSC["fact_user_status_changes"]
        end

        subgraph DimViews["Dimension Views"]
            VDS["view_dim_user_status\n(SCD2)"]
        end

        subgraph AnalyticalViews["Analytical Views (Dashboard-Ready)"]
            VUTS["view_user_transaction_summary\n(user behavior)"]
            VULC["view_user_login_countries\n(geo risk)"]
            VHTS["view_hourly_transaction_stats\n(time trend)"]
            VCTS["view_country_transaction_stats\n(geo distribution)"]
        end
    end

    subgraph Downstream["Downstream Services (Future)"]
        GW["Gateway Service\n(block transactions)"]
        NOTIF["Notification Service\n(SMS / email)"]
    end

    GEN_TXN --> T_TXN
    GEN_LOGIN --> T_LOGIN
    FRAUD --> T_TXN

    T_TXN --> PARSE
    T_LOGIN --> PARSE

    PARSE -->|"valid txn"| FT
    PARSE -->|"valid login"| FL
    PARSE -->|"TypeError / JSONError"| DLQ_SEND

    FT --> LATE
    LATE -->|"on time"| VELOCITY
    LATE -->|"late"| DLQ_SEND

    VELOCITY -->|"anomaly detected"| FSC
    VELOCITY -->|"anomaly detected"| ALERT_SEND

    DLQ_SEND --> T_DLQ
    ALERT_SEND --> T_ALERTS

    T_ALERTS -.-> GW
    T_ALERTS -.-> NOTIF

    FT -.-> VUTS
    FT -.-> VHTS
    FT -.-> VCTS
    FL -.-> VULC
    FSC -.-> VDS
